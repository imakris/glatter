@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenGL)

if(NOT WIN32)
    find_dependency(X11)
    find_dependency(Threads)
endif()

if(APPLE)
    find_library(GLATTER_X11_GL_LIBRARY GL NAMES GL.1 HINTS /opt/X11/lib)
    if(NOT GLATTER_X11_GL_LIBRARY)
        set(glatter_FOUND FALSE)
        set(glatter_NOT_FOUND_MESSAGE "The X11-compatible GL library was not found")
        return()
    endif()

    if(NOT TARGET glatter::x11_gl)
        add_library(glatter::x11_gl INTERFACE IMPORTED)
        set_property(TARGET glatter::x11_gl PROPERTY
            INTERFACE_LINK_LIBRARIES "${GLATTER_X11_GL_LIBRARY}")
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/glatter-targets.cmake")

check_required_components(glatter)
